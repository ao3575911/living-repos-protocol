{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ao3575911/living-repos-protocol/main/schemas/manifest.schema.json",
  "title": "Living Repository Manifest",
  "description": "Manifest at .living/manifest.yaml. Defined in docs/spec.md.",
  "type": "object",
  "required": ["protocol_version", "project_id", "agent_capabilities", "isolation_profile", "state_publication", "logging_requirements"],
  "additionalProperties": false,
  "patternProperties": {
    "^x-": {}
  },
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^v\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "agent_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["run_tasks", "publish_state", "open_pull_requests", "snapshot_restore", "handoff"]
      }
    },
    "isolation_profile": {
      "enum": ["dedicated-vm", "container", "sandbox-process"]
    },
    "state_publication": {
      "type": "object",
      "required": ["target"],
      "additionalProperties": false,
      "properties": {
        "target": { "enum": ["control-process", "file", "webhook"] },
        "path": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" }
      },
      "allOf": [
        { "if": { "properties": { "target": { "const": "file" } } }, "then": { "required": ["path"] } },
        { "if": { "properties": { "target": { "const": "webhook" } } }, "then": { "required": ["url"] } }
      ]
    },
    "logging_requirements": {
      "type": "object",
      "required": ["structured"],
      "additionalProperties": false,
      "properties": {
        "structured": { "type": "boolean" },
        "level": { "enum": ["debug", "info", "warn", "error"] }
      }
    }
  }
}
